# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Адрес сайта (для ссылок из бота). Кнопка «Открыть на сайте» появится только при https.
SHOP_BASE_URL=http://localhost:8080

# Вход в админку /admin — обязательно смените
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Пароль базы (используется docker-compose)
DB_PASSWORD=pcshop

# Telegram-бот. Если BOT_TOKEN пустой, сайт работает без бота.
BOT_TOKEN=
BOT_USERNAME=
# Ваш chat id: сюда приходят уведомления о новых и оплаченных заказах
ADMIN_CHAT_ID=
# Платёжный токен из BotFather → Payments. Пусто = тестовая кнопка оплаты без денег.
TELEGRAM_PAYMENT_TOKEN=

# Оплата на сайте через ЮKassa: shopId и секретный ключ из личного кабинета (Интеграция → Ключи API).
# Пусто = тестовая форма карты без денег. Подробности в README, раздел «Оплата через ЮKassa».
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Почта (ссылки для смены пароля). Без этих строк письма уходят в Mailpit из docker-compose,
# их видно на http://localhost:8025. Для настоящей отправки раскомментируйте и укажите SMTP своей почты.
# MAIL_HOST=smtp.yandex.ru
# MAIL_PORT=587
# Для порта 465 добавьте MAIL_SSL=true
# MAIL_SSL=true
# MAIL_USERNAME=shop@yandex.ru
# MAIL_PASSWORD=пароль-приложения
# Отправитель. Обычно должен совпадать с MAIL_USERNAME, иначе сервер не примет письмо
# MAIL_FROM=Сборка <shop@yandex.ru>

# Яндекс Метрика: номер счётчика из metrika.yandex.ru. Пусто = без счётчика.
# Счётчик включается только после согласия посетителя на cookie (плашка внизу сайта)
YANDEX_METRIKA_ID=
