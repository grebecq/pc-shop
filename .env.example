# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Адрес сайта (для ссылок из бота). Кнопка «Открыть на сайте» появится только при https.
SHOP_BASE_URL=http://localhost:8080

# Вход в админку /admin — обязательно смените
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Пароль базы (используется docker-compose)
DB_PASSWORD=pcshop

# Telegram-бот. Если BOT_TOKEN пустой, сайт работает без бота.
BOT_TOKEN=
BOT_USERNAME=
# Ваш chat id: сюда приходят уведомления о новых и оплаченных заказах
ADMIN_CHAT_ID=
# Платёжный токен из BotFather → Payments. Пусто = тестовая кнопка оплаты без денег.
TELEGRAM_PAYMENT_TOKEN=
